<svg xmlns="http://www.w3.org/2000/svg" width="840" height="220" viewBox="0 0 840 220" role="img" font-family="{{.Font}}">
  <title>AtCoder {{x .D.User}}: レート {{.D.Current}}</title>
  <rect x="1" y="1" width="838" height="218" rx="16" fill="{{.P.Surface}}" stroke="{{.P.Border}}" stroke-width="2"/>
  <text x="40" y="56" font-size="13" font-weight="600" fill="{{.P.Accent}}">AtCoder · {{x .D.User}}</text>
  <text x="40" y="112" font-size="48" font-weight="700" fill="{{.P.Ink}}">{{.D.Current}}</text>
  <rect x="40" y="126" width="180" height="6" rx="3" fill="{{.D.Color}}"/>
  <text x="40" y="160" font-size="14" fill="{{.P.InkMuted}}">最高 {{.D.Highest}} ・ 参加 {{.D.Contests}} 回</text>
  {{- range .L.Grid}}
  <line x1="320" y1="{{f .}}" x2="800" y2="{{f .}}" stroke="{{$.P.Border}}" stroke-width="1"/>
  {{- end}}
  <polyline points="{{.L.Points}}" fill="none" stroke="{{.P.Accent}}" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round"/>
  <circle cx="{{f .L.LastX}}" cy="{{f .L.LastY}}" r="6" fill="{{.D.Color}}" stroke="{{.P.Surface}}" stroke-width="2"/>
</svg>
