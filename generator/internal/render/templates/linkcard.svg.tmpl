<svg xmlns="http://www.w3.org/2000/svg" width="270" height="80" viewBox="0 0 270 80" role="img" font-family="{{.Font}}">
  <title>{{x .D.Label}}: {{x .D.Detail}}</title>
  <rect x="1" y="1" width="268" height="78" rx="12" fill="{{.P.Surface}}" stroke="{{.P.Border}}" stroke-width="2"/>
  <text x="20" y="32" font-size="13" font-weight="600" fill="{{.P.Accent}}">{{x .D.Label}}</text>
  <text x="20" y="58" font-size="16" font-weight="700" fill="{{.P.Ink}}">{{x (trunc .D.Detail 22)}}</text>
  <text x="248" y="50" font-size="18" text-anchor="end" fill="{{.P.Pen}}">→</text>
</svg>
