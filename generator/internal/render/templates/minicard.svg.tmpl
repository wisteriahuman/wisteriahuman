  <text x="18" y="32" font-size="15" font-weight="700" fill="{{.P.Ink}}">{{x (trunc .D.Title 18)}}</text>
  <circle cx="22" cy="50" r="4" fill="{{.P.Accent}}"/>
  <text x="32" y="54" font-size="12" fill="{{.P.InkMuted}}">{{x .D.Meta}}</text>
